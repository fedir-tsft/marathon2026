{
  "name": "restaurant-aqa-framework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test --grep @api",
    "test:ui": "playwright test --grep @ui",
    "test:level1": "playwright test --grep @level1",
    "test:level2": "playwright test --grep @level2",
    "test:level3": "playwright test --grep @level3",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@reportportal/agent-js-playwright": "^5.3.2",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.1",
    "typescript": "^5.6.3"
  }
}
